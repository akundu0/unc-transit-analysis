# ── GTFS-RT Feed URLs ──────────────────────────────────────────────────────
# Replace these placeholders with the actual UNC/Chapel Hill Transit GTFS-RT
# endpoint URLs once you have them.
GTFS_RT_VEHICLE_POSITIONS_URL=http://localhost:8999/mock/vehicle_positions
GTFS_RT_TRIP_UPDATES_URL=http://localhost:8999/mock/trip_updates

# ── Polling interval ───────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=15

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (default — no external service required):
DATABASE_URL=sqlite:///./unc_transit.db

# Postgres alternative (uncomment + fill in if you have a Postgres instance):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/unc_transit

# ── Serving API ────────────────────────────────────────────────────────────
SERVING_API_URL=http://localhost:8000

# ── Dashboard refresh ──────────────────────────────────────────────────────
DASHBOARD_REFRESH_SECONDS=15
