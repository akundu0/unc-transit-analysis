# ── GTFS-RT Feed URLs ──────────────────────────────────────────────────────
# Chapel Hill Transit real-time feeds:
GTFS_RT_VEHICLE_POSITIONS_URL=https://mychtransit.org/gtfs-rt/vehiclepositions
GTFS_RT_TRIP_UPDATES_URL=https://mychtransit.org/gtfs-rt/tripupdates
# For local testing with the mock server instead:
# GTFS_RT_VEHICLE_POSITIONS_URL=http://localhost:8999/mock/vehicle_positions
# GTFS_RT_TRIP_UPDATES_URL=http://localhost:8999/mock/trip_updates

# ── Polling interval ───────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=15

# ── Database ───────────────────────────────────────────────────────────────
# Option 1: SQLite (default — no external service required):
DATABASE_URL=sqlite:///./unc_transit.db

# Option 2: Supabase Cloud Postgres (recommended for production):
# Get the Session Mode connection string from Supabase:
#   Settings → Database → Connection string → URI tab
# Replace [YOUR-PASSWORD] and [PROJECT-REF] with your values.
# DATABASE_URL=postgresql+psycopg2://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Option 3: Local Postgres (via docker-compose):
# DATABASE_URL=postgresql+psycopg2://transit:transit@localhost:5432/unc_transit

# ── Data retention ────────────────────────────────────────────────────────
# Auto-delete rows older than N days (keeps Supabase free tier under 500 MB)
RETENTION_DAYS=30

# ── Serving API ────────────────────────────────────────────────────────────
SERVING_API_URL=http://localhost:8000

# ── Dashboard refresh ──────────────────────────────────────────────────────
DASHBOARD_REFRESH_SECONDS=15
